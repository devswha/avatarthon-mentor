	<Item class="ReplicatedStorage" referent="RBXA70621E22E3B4E77A1A5F4B633AE71FF">
		<Properties>
			<string name="Name">ReplicatedStorage</string>
		</Properties>
		<Item class="ModuleScript" referent="RBX80EB36BE51D545D79876A17DBFE7D10E">
			<Properties>
				<string name="Name">GameConfig</string>
				<ProtectedString name="Source"><![CDATA[-- GameConfig (ModuleScript in ReplicatedStorage)
-- Numbers and colors shared by the server and the client.
-- Tune the game here without touching the main scripts.

local GameConfig = {}

-- Gameplay feel
GameConfig.BOUNCE_SPEED = 95 -- upward speed a mushroom gives you (about 23 studs high)
GameConfig.FADE_WARNING = 0.35 -- seconds a glass tile blinks before it starts to vanish
GameConfig.FADE_TIME = 0.6 -- seconds a glass tile takes to disappear
GameConfig.FADE_RESPAWN = 2.5 -- seconds before a vanished tile comes back
GameConfig.SPINNER_SPEED = 1.4 -- spinning bar speed (radians per second)
GameConfig.STAR_SPIN_SPEED = 2.2 -- how fast stars turn
GameConfig.RESPAWN_TIME = 1 -- seconds before you come back after falling
GameConfig.TOTAL_ZONES = 4 -- start area + 3 checkpoints

-- Blender props
-- In Roblox Studio use File > Import 3D and pick AvatarthonProps.fbx.
-- The imported model keeps this name. The BlenderProps script finds it and
-- puts a copy of each prop on every matching spot in the course.
GameConfig.PROP_MODEL_NAME = "AvatarthonProps"

-- size: target size in studs, by: which side to measure,
-- pivot: which point of the prop sits on the spot's PropAnchor part
GameConfig.PROPS = {
	StarCoin = { size = 3.2, by = "height", pivot = "bottom" },
	JumpMushroom = { size = 6.5, by = "width", pivot = "bottom" },
	CheckFlag = { size = 8, by = "height", pivot = "bottom" },
	GoalTrophy = { size = 8, by = "height", pivot = "bottom" },
	CloudPad = { size = 10, by = "width", pivot = "top" },
}

-- Which course folder uses which prop
GameConfig.PROP_FOLDERS = {
	Stars = "StarCoin",
	JumpPads = "JumpMushroom",
	Checkpoints = "CheckFlag",
	Goal = "GoalTrophy",
	Clouds = "CloudPad",
}

-- Mesh colors (same as the Blender materials), so the props look right
-- even if the importer drops the material colors.
GameConfig.MESH_COLORS = {
	StarCoin_Body = Color3.fromRGB(255, 200, 61),
	JumpMushroom_Cap = Color3.fromRGB(232, 70, 60),
	JumpMushroom_Dots = Color3.fromRGB(255, 246, 232),
	JumpMushroom_Stem = Color3.fromRGB(243, 221, 179),
	CheckFlag_Pole = Color3.fromRGB(230, 230, 234),
	CheckFlag_Cloth = Color3.fromRGB(63, 169, 245),
	CheckFlag_Base = Color3.fromRGB(74, 79, 90),
	GoalTrophy_Cup = Color3.fromRGB(255, 200, 61),
	GoalTrophy_Base = Color3.fromRGB(91, 58, 140),
	CloudPad_Body = Color3.fromRGB(255, 255, 255),
}

-- A reached checkpoint turns this color on your screen
GameConfig.REACHED_COLOR = Color3.fromRGB(80, 220, 120)

-- Spinning bar angle from the shared server clock, so every screen agrees.
-- The clock is a huge number (seconds since 1970), so wrap it to one turn
-- BEFORE it goes into CFrame.Angles, which works in lower precision.
function GameConfig.spinnerAngle(serverTime)
	return (serverTime * GameConfig.SPINNER_SPEED) % (2 * math.pi)
end

return GameConfig
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBX0A317951FE754845849CB3E08BC7B050">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="Script" referent="RBXE024B248040A4A4FB7822FF1E547C715">
			<Properties>
				<string name="Name">BlenderProps</string>
				<ProtectedString name="Source"><![CDATA[-- BlenderProps (Script in ServerScriptService)
-- Swaps the basic-part placeholders for the props made in Blender.
--
-- How to use (once, in Roblox Studio):
--   1. File > Import 3D > choose AvatarthonProps.fbx
--   2. Leave the imported model "AvatarthonProps" in Workspace
--      (or drag it into ServerStorage so it is out of sight)
--   3. Press Play. This script copies each Blender prop onto every spot.
-- If the model is not there, the placeholders stay and the game still works.
--
-- Every spot in the course is a Model with:
--   PropAnchor  - invisible part: where the prop stands and which way it faces
--   Placeholder - the basic-part version (hidden once the Blender prop is in)
-- Collisions never come from the Blender meshes, so the course plays the same
-- with or without them.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("GameConfig"))
local course = workspace:WaitForChild("Course")

local function findImportedModel()
	for _, container in { workspace, ServerStorage, ReplicatedStorage } do
		local found = container:FindFirstChild(GameConfig.PROP_MODEL_NAME, true)
		if found then
			return found
		end
	end
	return nil
end

-- "JumpMushroom_Cap.001" -> kind "JumpMushroom", mesh name "JumpMushroom_Cap"
local function splitMeshName(name)
	local kind, part = string.match(name, "^(%w+)_(%w+)")
	if not kind then
		return nil, nil
	end
	return kind, kind .. "_" .. part
end

-- Group the imported meshes by prop and make one ready-to-copy model per prop
local function buildLibrary(imported, holder)
	local groups = {}
	for _, item in imported:GetDescendants() do
		if item:IsA("BasePart") then
			local kind, meshName = splitMeshName(item.Name)
			if kind and GameConfig.PROPS[kind] then
				groups[kind] = groups[kind] or {}
				table.insert(groups[kind], { part = item, meshName = meshName })
			end
		end
	end

	local library = {}
	for kind, entries in groups do
		local spec = GameConfig.PROPS[kind]
		local model = Instance.new("Model")
		model.Name = kind
		for _, entry in entries do
			local copy = entry.part:Clone()
			copy.Anchored = true
			copy.CanCollide = false
			copy.CanTouch = false
			copy.CanQuery = false
			copy.Massless = true
			local color = GameConfig.MESH_COLORS[entry.meshName]
			if color then
				copy.Color = color
			end
			copy.Parent = model
		end
		model.Parent = holder

		-- Measure with a world-aligned box, scale to the target size,
		-- then move the pivot to the bottom (or top) center of the prop.
		model.WorldPivot = CFrame.new()
		local _, size = model:GetBoundingBox()
		local current = if spec.by == "width" then math.max(size.X, size.Z) else size.Y
		if current > 0 then
			model:ScaleTo(spec.size / current)
		end
		local boxCFrame, boxSize = model:GetBoundingBox()
		local yOffset = if spec.pivot == "top" then boxSize.Y / 2 else -boxSize.Y / 2
		model.WorldPivot = CFrame.new(boxCFrame.Position + Vector3.new(0, yOffset, 0))
		library[kind] = model
	end
	return library
end

local function placeProp(spot, template)
	local anchor = spot:FindFirstChild("PropAnchor")
	if not anchor then
		return
	end
	local copy = template:Clone()
	copy.Name = "BlenderMesh"
	copy:PivotTo(anchor.CFrame)
	copy.Parent = spot

	local placeholder = spot:FindFirstChild("Placeholder")
	if placeholder then
		for _, part in placeholder:GetDescendants() do
			if part:IsA("BasePart") then
				part.Transparency = 1 -- hidden, but still solid where it was solid
			end
		end
	end
end

local imported = findImportedModel()
if not imported then
	print("[BlenderProps] '" .. GameConfig.PROP_MODEL_NAME .. "' not found - using basic-part placeholders")
else
	imported.Parent = ServerStorage -- keep the original out of the course

	local holder = Instance.new("Folder")
	holder.Name = "PropLibrary"
	holder.Parent = ServerStorage

	local library = buildLibrary(imported, holder)
	local placed = 0
	for folderName, kind in GameConfig.PROP_FOLDERS do
		local folder = course:FindFirstChild(folderName)
		local template = library[kind]
		if folder and template then
			for _, spot in folder:GetChildren() do
				placeProp(spot, template)
				placed += 1
			end
		elseif not template then
			warn("[BlenderProps] no meshes named " .. kind .. "_* inside " .. GameConfig.PROP_MODEL_NAME)
		end
	end
	print(string.format("[BlenderProps] placed %d Blender props", placed))
end
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX0AF583402596455C8B91BE0637A10E70">
			<Properties>
				<string name="Name">GameServer</string>
				<ProtectedString name="Source"><![CDATA[-- GameServer (Script in ServerScriptService)
-- The rules of the game: stars, checkpoints, hazards, glass tiles,
-- the spinning bar and the goal. The client script draws things and
-- handles your own character (mushroom bounce, spinning-bar hits).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local GameConfig = require(ReplicatedStorage:WaitForChild("GameConfig"))

local course = workspace:WaitForChild("Course")
local starsFolder = course:WaitForChild("Stars")
local checkpointsFolder = course:WaitForChild("Checkpoints")
local hazardsFolder = course:WaitForChild("Hazards")
local tilesFolder = course:WaitForChild("FadingTiles")
local signsFolder = course:WaitForChild("Signs")
local goalModel = course:WaitForChild("Goal"):WaitForChild("Goal")

Players.RespawnTime = GameConfig.RESPAWN_TIME

-- Remote events: the server tells each player's screen what happened
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"

local function makeRemote(name)
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = remotes
	return remote
end

local starCollected = makeRemote("StarCollected")
local checkpointReached = makeRemote("CheckpointReached")
local goalReached = makeRemote("GoalReached")
local restartRequest = makeRemote("RestartRequest")
local spinnerHit = makeRemote("SpinnerHit")
remotes.Parent = ReplicatedStorage

local TOTAL_STARS = #starsFolder:GetChildren()

-- progress[player] = { collected = { [starModel] = true }, zone = 1, finished = false }
local progress = {}

-- Which living player (if any) does this touching part belong to?
local function getPlayerFromPart(part)
	local character = part:FindFirstAncestorOfClass("Model")
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	local player = Players:GetPlayerFromCharacter(character)
	if not player then
		return nil
	end
	return player, humanoid
end

local function getStat(player, statName)
	local leaderstats = player:FindFirstChild("leaderstats")
	return leaderstats and leaderstats:FindFirstChild(statName)
end

local function resetProgress(player)
	progress[player] = { collected = {}, zone = 1, finished = false }
	local stars = getStat(player, "별")
	if stars then
		stars.Value = 0
	end
	local zone = getStat(player, "구역")
	if zone then
		zone.Value = 1
	end
	player:SetAttribute("TotalStars", TOTAL_STARS)
	player:SetAttribute("StartTime", workspace:GetServerTimeNow())
	player:SetAttribute("FinishTime", nil)
end

-- Put the character back on its last checkpoint
local function moveToCheckpoint(player, character)
	local data = progress[player]
	if not data or data.zone <= 1 then
		return -- zone 1 uses the normal start spawn
	end
	local checkpoint = checkpointsFolder:FindFirstChild("Checkpoint" .. (data.zone - 1))
	local pad = checkpoint and checkpoint:FindFirstChild("Pad")
	local root = character:WaitForChild("HumanoidRootPart", 5)
	if not pad or not root then
		return
	end
	if not character.Parent then
		character.AncestryChanged:Wait() -- wait until the character is in the world
	end
	task.wait() -- let the default spawn finish first
	character:PivotTo(CFrame.new(pad.Position + Vector3.new(0, 4, 0)))
end

local function setupPlayer(player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local stars = Instance.new("IntValue")
	stars.Name = "별"
	stars.Parent = leaderstats

	local zone = Instance.new("IntValue")
	zone.Name = "구역"
	zone.Value = 1
	zone.Parent = leaderstats

	leaderstats.Parent = player
	resetProgress(player)

	player.CharacterAdded:Connect(function(character)
		moveToCheckpoint(player, character)
	end)
end

Players.PlayerAdded:Connect(setupPlayer)
for _, player in Players:GetPlayers() do
	setupPlayer(player)
end

Players.PlayerRemoving:Connect(function(player)
	progress[player] = nil
end)

-- Stars: each player collects their own stars
for _, star in starsFolder:GetChildren() do
	local hitbox = star:WaitForChild("Hitbox")
	hitbox.Touched:Connect(function(hit)
		local player = getPlayerFromPart(hit)
		local data = player and progress[player]
		if not data or data.collected[star] then
			return
		end
		data.collected[star] = true
		local stars = getStat(player, "별")
		if stars then
			stars.Value += 1
		end
		starCollected:FireClient(player, star)
	end)
end

-- Checkpoints: CheckpointN moves you into zone N + 1
for _, checkpoint in checkpointsFolder:GetChildren() do
	local number = tonumber(string.match(checkpoint.Name, "%d+"))
	local pad = checkpoint:WaitForChild("Pad")
	if number then
		pad.Touched:Connect(function(hit)
			local player = getPlayerFromPart(hit)
			local data = player and progress[player]
			if not data or number + 1 <= data.zone then
				return
			end
			data.zone = number + 1
			local zone = getStat(player, "구역")
			if zone then
				zone.Value = data.zone
			end
			checkpointReached:FireClient(player, number)
		end)
	end
end

-- Hazards (lava, water): touching one sends you back to your checkpoint
for _, hazard in hazardsFolder:GetChildren() do
	if hazard:IsA("BasePart") then
		hazard.Touched:Connect(function(hit)
			local _, humanoid = getPlayerFromPart(hit)
			if humanoid then
				humanoid.Health = 0
			end
		end)
	end
end

-- Glass tiles: blink, fade away, then come back
for _, tile in tilesFolder:GetChildren() do
	if tile:IsA("BasePart") then
		local busy = false
		local startColor = tile.Color
		local startTransparency = tile.Transparency
		tile.Touched:Connect(function(hit)
			if busy or not getPlayerFromPart(hit) then
				return
			end
			busy = true
			tile.Color = Color3.fromRGB(255, 170, 60)
			task.wait(GameConfig.FADE_WARNING)
			local fade = TweenService:Create(tile, TweenInfo.new(GameConfig.FADE_TIME), { Transparency = 1 })
			fade:Play()
			fade.Completed:Wait()
			tile.CanCollide = false
			task.wait(GameConfig.FADE_RESPAWN)
			tile.Color = startColor
			tile.Transparency = startTransparency
			tile.CanCollide = true
			busy = false
		end)
	end
end

-- Spinning bars: each player's screen spins the bar and checks its own
-- character against it (what you see is what hits you, even with lag).
-- The screen then asks the server to send that player back.
spinnerHit.OnServerEvent:Connect(function(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid.Health = 0
	end
end)

-- Goal
local goalPad = goalModel:WaitForChild("Pad")
goalPad.Touched:Connect(function(hit)
	local player = getPlayerFromPart(hit)
	local data = player and progress[player]
	-- you must have passed the last checkpoint (also ignores the old character
	-- still standing on the pad right after "play again")
	if not data or data.finished or data.zone < GameConfig.TOTAL_ZONES then
		return
	end
	data.finished = true
	local now = workspace:GetServerTimeNow()
	player:SetAttribute("FinishTime", now)
	local stars = getStat(player, "별")
	goalReached:FireClient(player, {
		stars = stars and stars.Value or 0,
		total = TOTAL_STARS,
		seconds = now - (player:GetAttribute("StartTime") or now),
	})
end)

-- "Play again" button on the goal screen
restartRequest.OnServerEvent:Connect(function(player)
	local data = progress[player]
	if not data or not data.finished then
		return
	end
	resetProgress(player)
	restartRequest:FireClient(player)
	player:LoadCharacter()
end)

-- Signs: each sign part has a StringValue "Text"
for _, sign in signsFolder:GetChildren() do
	local textValue = sign:FindFirstChild("Text")
	if sign:IsA("BasePart") and textValue then
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Back -- the side that faces players coming down the course
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.LightInfluence = 0

		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.Text = textValue.Value
		label.TextScaled = true
		label.TextColor3 = Color3.new(1, 1, 1)
		label.Parent = gui

		local padding = Instance.new("UIPadding")
		padding.PaddingLeft = UDim.new(0.04, 0)
		padding.PaddingRight = UDim.new(0.04, 0)
		padding.PaddingTop = UDim.new(0.08, 0)
		padding.PaddingBottom = UDim.new(0.08, 0)
		padding.Parent = label

		gui.Parent = sign
	end
end

print(string.format("[GameServer] ready: %d stars, %d checkpoints", TOTAL_STARS, #checkpointsFolder:GetChildren()))
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>
	<Item class="ServerStorage" referent="RBX90808556F0BB41E488CD44C5AF5C0E0D">
		<Properties>
			<string name="Name">ServerStorage</string>
		</Properties>
	</Item>
	<Item class="StarterPlayer" referent="RBX989F52DE75CE4EE5AA500749E471C2BC">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX5B473B23B49942A6A2463AAD696437CF">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="LocalScript" referent="RBXD241EDA5E38044B19C0838B0E6706678">
				<Properties>
					<string name="Name">GameClient</string>
					<ProtectedString name="Source"><![CDATA[-- GameClient (LocalScript in StarterPlayerScripts)
-- What each player sees and feels: the score bar, spinning stars,
-- mushroom bounces, spinning bars and the goal screen.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local GameConfig = require(ReplicatedStorage:WaitForChild("GameConfig"))
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local course = workspace:WaitForChild("Course")
local starsFolder = course:WaitForChild("Stars")

local FONT = Enum.Font.FredokaOne
local WHITE = Color3.new(1, 1, 1)

---------------------------------------------------------------------------
-- Screen: score bar, short messages and the goal panel
---------------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "GameHud"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local function addCorner(parent, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = radius
	corner.Parent = parent
end

local function makeLabel(parent, text, textSize)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Font = FONT
	label.Text = text
	label.TextSize = textSize
	label.TextColor3 = WHITE
	label.Parent = parent
	return label
end

local scoreBar = Instance.new("Frame")
scoreBar.AnchorPoint = Vector2.new(0.5, 0)
scoreBar.Position = UDim2.new(0.5, 0, 0, 10)
scoreBar.Size = UDim2.fromOffset(500, 50)
scoreBar.BackgroundColor3 = Color3.fromRGB(34, 30, 58)
scoreBar.BackgroundTransparency = 0.15
scoreBar.Parent = gui
addCorner(scoreBar, UDim.new(0.5, 0))

local scoreLabel = makeLabel(scoreBar, "", 26)
scoreLabel.AnchorPoint = Vector2.new(0.5, 0.5)
scoreLabel.Position = UDim2.fromScale(0.5, 0.5)
scoreLabel.Size = UDim2.new(1, -28, 1, -10)
scoreLabel.TextScaled = true
local scoreTextLimit = Instance.new("UITextSizeConstraint")
scoreTextLimit.MaxTextSize = 26
scoreTextLimit.Parent = scoreLabel

local toast = makeLabel(gui, "", 30)
toast.AnchorPoint = Vector2.new(0.5, 0)
toast.Position = UDim2.new(0.5, 0, 0, 70)
toast.Size = UDim2.fromOffset(520, 44)
toast.TextStrokeTransparency = 0.2
toast.Visible = false

local toastId = 0
local function showToast(text, color)
	toastId += 1
	local myId = toastId
	toast.Text = text
	toast.TextColor3 = color or WHITE
	toast.Visible = true
	task.delay(1.8, function()
		if toastId == myId then
			toast.Visible = false
		end
	end)
end

-- Goal panel
local goalPanel = Instance.new("Frame")
goalPanel.AnchorPoint = Vector2.new(0.5, 0.5)
goalPanel.Position = UDim2.fromScale(0.5, 0.5)
goalPanel.Size = UDim2.fromOffset(420, 300)
goalPanel.BackgroundColor3 = Color3.fromRGB(34, 30, 58)
goalPanel.BackgroundTransparency = 0.05
goalPanel.Visible = false
goalPanel.Parent = gui
addCorner(goalPanel, UDim.new(0, 24))

local goalTitle = makeLabel(goalPanel, "🏆 골인!", 54)
goalTitle.Position = UDim2.fromOffset(0, 24)
goalTitle.Size = UDim2.new(1, 0, 0, 64)
goalTitle.TextColor3 = Color3.fromRGB(255, 210, 70)

local goalBody = makeLabel(goalPanel, "", 30)
goalBody.Position = UDim2.fromOffset(0, 100)
goalBody.Size = UDim2.new(1, 0, 0, 90)

local againButton = Instance.new("TextButton")
againButton.AnchorPoint = Vector2.new(0.5, 1)
againButton.Position = UDim2.new(0.5, 0, 1, -24)
againButton.Size = UDim2.fromOffset(260, 56)
againButton.BackgroundColor3 = Color3.fromRGB(80, 200, 120)
againButton.Font = FONT
againButton.Text = "처음부터 다시 하기"
againButton.TextSize = 28
againButton.TextColor3 = WHITE
againButton.Parent = goalPanel
addCorner(againButton, UDim.new(0, 16))

local function formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d", math.floor(seconds / 60), seconds % 60)
end

local function getStatValue(statName)
	local leaderstats = player:FindFirstChild("leaderstats")
	local stat = leaderstats and leaderstats:FindFirstChild(statName)
	return stat and stat.Value or 0
end

local function updateScore()
	local startTime = player:GetAttribute("StartTime")
	local endTime = player:GetAttribute("FinishTime") or workspace:GetServerTimeNow()
	local elapsed = if startTime then endTime - startTime else 0
	scoreLabel.Text = string.format(
		"⭐ %d / %d     🚩 %d / %d 구역     ⏱ %s",
		getStatValue("별"),
		player:GetAttribute("TotalStars") or 0,
		math.max(1, getStatValue("구역")),
		GameConfig.TOTAL_ZONES,
		formatTime(elapsed)
	)
end

---------------------------------------------------------------------------
-- Little effects
---------------------------------------------------------------------------
local function burst(position, colors, count)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanTouch = false
	holder.CanQuery = false
	holder.Transparency = 1
	holder.Size = Vector3.new(1, 1, 1)
	holder.Position = position
	holder.Parent = workspace

	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = colors
	emitter.LightEmission = 0.6
	emitter.Lifetime = NumberRange.new(0.5, 1)
	emitter.Speed = NumberRange.new(12, 22)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.7),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Enabled = false
	emitter.Parent = holder
	emitter:Emit(count)
	Debris:AddItem(holder, 1.5)
end

local GOLD = ColorSequence.new(Color3.fromRGB(255, 220, 80), Color3.fromRGB(255, 160, 40))
local PARTY = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 90)),
	ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 220, 80)),
	ColorSequenceKeypoint.new(0.66, Color3.fromRGB(90, 200, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(160, 110, 255)),
})

---------------------------------------------------------------------------
-- Stars: spin and bob on screen, vanish when collected
---------------------------------------------------------------------------
local spinning = {} -- [starModel] = { center = CFrame, parts = { { part, offset } } }
local hiddenStars = {} -- stars this player already collected
local originalCFrames = {} -- first CFrame we saw for each star part
local pendingRefresh = {}

local function refreshStar(star)
	pendingRefresh[star] = nil
	local hitbox = star:FindFirstChild("Hitbox")
	if not hitbox or hiddenStars[star] then
		return
	end
	local center = hitbox.CFrame
	local parts = {}
	for _, item in star:GetDescendants() do
		if item:IsA("BasePart") and item ~= hitbox and item.Name ~= "PropAnchor" then
			originalCFrames[item] = originalCFrames[item] or item.CFrame
			table.insert(parts, { part = item, offset = center:ToObjectSpace(originalCFrames[item]) })
		end
	end
	spinning[star] = { center = center, parts = parts }
end

for _, star in starsFolder:GetChildren() do
	refreshStar(star)
	-- the Blender mesh can arrive a moment later: rebuild once it does
	star.DescendantAdded:Connect(function(item)
		if item:IsA("BasePart") and not pendingRefresh[star] then
			pendingRefresh[star] = true
			task.defer(refreshStar, star)
		end
	end)
end

remotes:WaitForChild("StarCollected").OnClientEvent:Connect(function(star)
	if hiddenStars[star] then
		return
	end
	local hitbox = star:FindFirstChild("Hitbox")
	if hitbox then
		burst(hitbox.Position, GOLD, 24)
	end
	hiddenStars[star] = true
	spinning[star] = nil
	star.Parent = nil -- only on this player's screen
	showToast(string.format("⭐ 별 %d / %d", getStatValue("별"), player:GetAttribute("TotalStars") or 0))
end)

---------------------------------------------------------------------------
-- Checkpoints: flag turns green on your screen
---------------------------------------------------------------------------
local checkpointsFolder = course:WaitForChild("Checkpoints")
local flagColors = {}

local function paintCheckpoint(checkpoint, color)
	for _, item in checkpoint:GetDescendants() do
		if item:IsA("BasePart") and (item.Name == "Pad" or string.find(item.Name, "Cloth")) then
			flagColors[item] = flagColors[item] or item.Color
			item.Color = color or flagColors[item]
		end
	end
end

remotes:WaitForChild("CheckpointReached").OnClientEvent:Connect(function(number)
	local checkpoint = checkpointsFolder:FindFirstChild("Checkpoint" .. number)
	if checkpoint then
		paintCheckpoint(checkpoint, GameConfig.REACHED_COLOR)
		local pad = checkpoint:FindFirstChild("Pad")
		if pad then
			burst(pad.Position + Vector3.new(0, 2, 0), PARTY, 30)
		end
	end
	showToast(string.format("🚩 체크포인트! 이제 %d구역", number + 1), GameConfig.REACHED_COLOR)
end)

---------------------------------------------------------------------------
-- Mushrooms: bounce your character up
---------------------------------------------------------------------------
local lastBounce = 0
for _, mushroom in course:WaitForChild("JumpPads"):GetChildren() do
	local pad = mushroom:WaitForChild("Pad")
	pad.Touched:Connect(function(hit)
		local character = player.Character
		if not character or not hit:IsDescendantOf(character) then
			return
		end
		local root = character:FindFirstChild("HumanoidRootPart")
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not root or not humanoid or humanoid.Health <= 0 then
			return
		end
		if os.clock() - lastBounce < 0.4 then
			return
		end
		lastBounce = os.clock()
		local velocity = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(velocity.X, GameConfig.BOUNCE_SPEED, velocity.Z)
		burst(pad.Position + Vector3.new(0, 1, 0), ColorSequence.new(Color3.fromRGB(255, 120, 110)), 14)
	end)
end

---------------------------------------------------------------------------
-- Spinning bars: every screen spins the bar with the shared server clock,
-- and checks only its own character, so what you see is what hits you.
---------------------------------------------------------------------------
local spinnerHit = remotes:WaitForChild("SpinnerHit")
local spinnerParams = OverlapParams.new()
spinnerParams.FilterType = Enum.RaycastFilterType.Include
local lastSpinnerHit = 0
local spinners = {}
for _, spinner in course:WaitForChild("Spinners"):GetChildren() do
	local hub = spinner:WaitForChild("Hub")
	local bar = spinner:WaitForChild("Bar")
	table.insert(spinners, {
		hub = hub,
		bar = bar,
		offset = CFrame.new(hub.Position):ToObjectSpace(bar.CFrame),
	})
end

local function checkSpinnerHit(barCFrame, barSize)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or os.clock() - lastSpinnerHit < 1 then
		return
	end
	spinnerParams.FilterDescendantsInstances = { character }
	for _, part in workspace:GetPartBoundsInBox(barCFrame, barSize, spinnerParams) do
		-- hats and hair have big boxes: only the body counts
		if not part:FindFirstAncestorOfClass("Accessory") then
			lastSpinnerHit = os.clock()
			spinnerHit:FireServer()
			return
		end
	end
end

---------------------------------------------------------------------------
-- Goal and restart
---------------------------------------------------------------------------
remotes:WaitForChild("GoalReached").OnClientEvent:Connect(function(result)
	goalBody.Text = string.format("모은 별  %d / %d\n기록  %s", result.stars, result.total, formatTime(result.seconds))
	goalPanel.Visible = true
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then
		for i = 0, 2 do
			task.delay(i * 0.35, burst, root.Position + Vector3.new(0, 3, 0), PARTY, 40)
		end
	end
end)

againButton.Activated:Connect(function()
	goalPanel.Visible = false
	remotes.RestartRequest:FireServer()
end)

remotes:WaitForChild("RestartRequest").OnClientEvent:Connect(function()
	goalPanel.Visible = false
	for star in hiddenStars do
		star.Parent = starsFolder
	end
	table.clear(hiddenStars)
	for _, star in starsFolder:GetChildren() do
		refreshStar(star)
	end
	for _, checkpoint in checkpointsFolder:GetChildren() do
		paintCheckpoint(checkpoint, nil)
	end
	showToast("다시 출발! ⭐ 별을 모아 보세요")
end)

---------------------------------------------------------------------------
-- Every frame
---------------------------------------------------------------------------
local clockStart = os.clock()
RunService.RenderStepped:Connect(function()
	local now = os.clock() - clockStart -- small numbers keep the spin smooth
	for _, info in spinning do
		local turn = info.center * CFrame.new(0, math.sin(now * 2) * 0.3, 0) * CFrame.Angles(0, (now * GameConfig.STAR_SPIN_SPEED) % (2 * math.pi), 0)
		for _, item in info.parts do
			item.part.CFrame = turn * item.offset
		end
	end

	local angle = GameConfig.spinnerAngle(workspace:GetServerTimeNow())
	for _, spinner in spinners do
		local barCFrame = CFrame.new(spinner.hub.Position) * CFrame.Angles(0, angle, 0) * spinner.offset
		spinner.bar.CFrame = barCFrame
		checkSpinnerHit(barCFrame, spinner.bar.Size)
	end

	updateScore()
end)

showToast("⭐ 별을 모으며 🏆 트로피까지 가 보세요!")
